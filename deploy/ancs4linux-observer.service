# Local version of upstream autorun/ancs4linux-observer.service: venv path, restart policy.
[Unit]
Description=ancs4linux Observer daemon (reads iPhone notifications over ANCS)
Requires=bluetooth.service
After=bluetooth.service

[Service]
# The account they run as is filled in by install.sh (ANCS_DAEMON_USER in /etc/ancs4linux.env; on fe-pro ancsd,
# SERVER.md "Accounts"). ancs4linux is the group the D-Bus policy lets talk to the services.
User=@ANCS_DAEMON_USER@
Group=@ANCS_DAEMON_USER@
SupplementaryGroups=ancs4linux
Type=dbus
BusName=ancs4linux.Observer
ExecStart=/opt/ancs4linux/venv/bin/ancs4linux-observer
Restart=always
RestartSec=5
# The observer pings the watchdog from its main loop (patch 0006); if the loop ever
# blocks again, systemd restarts it instead of it hanging silently.
WatchdogSec=60
NotifyAccess=main
# Hardening (fe-pro phase 2): nothing here writes to disk, talks IP, or needs a capability.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
