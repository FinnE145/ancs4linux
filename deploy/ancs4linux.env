# Config for the ancs4linux services (installed to /etc/ancs4linux.env). See deploy/README.md.
# Restart ancs4linux-advertise / ancs4linux-logger after changing.

# 1 = write full notification bodies to /var/log/ancs4linux/notifications.log.
# Debugging only: set back to 0 (and delete the log) once things work.
LOG_BODIES=0

# The account the four services run as. It must exist; install.sh adds it to the ancs4linux group and lets it own
# the two D-Bus names. On fe-pro: ancsd (uid 2006, SERVER.md "Accounts").
ANCS_DAEMON_USER=ancsd

# Optional. Bluetooth adapter to use (default /org/bluez/hci0).
#ADAPTER_PATH=/org/bluez/hci0

# Optional, read by install.sh: the user who runs the debug logger and is added to the
# ancs4linux group (allowed to call the observer). Default: the user who ran sudo.
#ANCS_USER=
