# fe-pro version of upstream autorun/ancs4linux-advertising.service: venv path, restart policy.
[Unit]
Description=ancs4linux Advertising daemon (BLE advertisement + pairing agent)
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=dbus
BusName=ancs4linux.Advertising
ExecStart=/opt/ancs4linux/venv/bin/ancs4linux-advertising
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
