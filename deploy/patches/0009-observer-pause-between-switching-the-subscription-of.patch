From a6113bf9dc764dd3a7deb53ab61072a82d474cb2 Mon Sep 17 00:00:00 2001
From: FinnE145 <finne014@gmail.com>
Date: Thu, 8 Oct 2026 14:38:06 +0000
Subject: [PATCH] observer: pause between switching the subscription off and on

bluetoothd replies to StopNotify immediately and writes the CCC disable
to the phone afterwards. Patch 0005's off/on toggle re-enabled
notifications while that write was pending, which hits a use-after-free
in BlueZ's gatt-client (fixed upstream after 5.87 by "shared/gatt-client:
Fix calling destroy after unregistering notify"). The corrupted heap
crashed bluetoothd on the next disconnect: 7 times in 4 days on 5.72 and
7 in 2 days on 5.87, all a few seconds after a quick reconnect, always
in device_store_svc_chng_ccc -> g_key_file_load_from_file ->
malloc_consolidate. It also garbled the phone's stored name.

Wait 1.5 s after StopNotify so the write completes first. (fe-pro's
BlueZ build also carries the upstream fix.)

---
 ancs4linux/observer/device.py | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/ancs4linux/observer/device.py b/ancs4linux/observer/device.py
index bc8844b..1dd9e4f 100644
--- a/ancs4linux/observer/device.py
+++ b/ancs4linux/observer/device.py
@@ -25,6 +25,7 @@ OBSERVER_STARTED = now_iso()
 # Every call to bluetoothd gets a limit; dasbus's default is to wait forever.
 CALL_TIMEOUT_MS = 10_000
 SUBSCRIBE_RETRY_SECONDS = 2
+STOP_START_PAUSE_MS = 1500
 SUBSCRIBE_MAX_ATTEMPTS = 60
 
 
@@ -193,6 +194,12 @@ class MobileDevice:
             # then iOS sends nothing: notifications that arrived or were cleared during
             # the gap would be missed. Switching it off and on forces the full list.
             (self.notification_source, "StopNotify"),
+            # bluetoothd replies to StopNotify at once and writes the "disable" to the phone
+            # afterwards. Re-enabling while that write is pending hits a use-after-free in
+            # BlueZ's gatt-client (fixed upstream after 5.87, "Fix calling destroy after
+            # unregistering notify"); the corrupted heap then crashed bluetoothd on the next
+            # disconnect. Give the write time to finish.
+            (None, "pause"),
             (self.notification_source, "StartNotify"),
         ]
 
@@ -222,6 +229,13 @@ class MobileDevice:
             return
         proxy, method = steps[0]
 
+        if method == "pause":
+            GLib.timeout_add(
+                STOP_START_PAUSE_MS,
+                lambda: self.run_subscribe_steps(generation, attempt, steps[1:]) and False,
+            )
+            return
+
         def done(call: Callable[[], Any]) -> None:
             try:
                 call()
